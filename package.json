{
  "name": "ci-gen",
  "version": "1.0.0",
  "description": "CLI-генератор GitLab CI из YAML-конфига",
  "keywords": [
    "gitlab",
    "ci",
    "yaml",
    "generator",
    "cli"
  ],
  "license": "MIT",
  "author": "ivano82ff-eng",
  "repository": {
    "type": "git",
    "url": "https://github.com/ivano82ff-eng/ci-gen.git"
  },
  "homepage": "https://www.npmjs.com/package/ci-gen",
  "bugs": {
    "url": "https://github.com/ivano82ff-eng/ci-gen/issues"
  },
  "type": "module",
  "bin": {
    "ci-gen": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "generate": "tsx src/index.ts generate",
    "validate": "tsx src/index.ts validate",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src tests --ext .ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
